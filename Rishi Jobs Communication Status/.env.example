# Copy this file to .env and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app.
# Leave VITE_FIREBASE_API_KEY empty to run in DEMO mode (data kept in this browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# Where CV files are uploaded: the Google Drive Apps Script web app (google-drive-upload/Code.gs).
VITE_CV_UPLOAD_URL=http://localhost:5299/upload

# Optional: the CV editor the PM uses to revise a PE's candidate's CV (Streamlit app in ../cv process).
# VITE_CV_EDITOR_URL=https://rishijobs-revisedcvs.streamlit.app
