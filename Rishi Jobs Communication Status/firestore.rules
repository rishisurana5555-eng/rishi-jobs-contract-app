rules_version = '2';

// Visibility and edit rights are enforced here, not only in the UI.
// Keep the stage/status lists in sync with src/workflow/workflow.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    // A login alone is not enough: the person must have an active profile in /users.
    function isMember() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.get('active', true) != false;
    }
    function myRole() {
      return get(profilePath()).data.role;
    }
    // Admins and the Super Admin see everything and manage setup.
    function isAdmin() {
      return isMember() && myRole() in ['Admin', 'SuperAdmin'];
    }
    function isSuperAdmin() {
      return isMember() && myRole() == 'SuperAdmin';
    }
    function isClientTeamMember() {
      return isMember() && get(profilePath()).data.role == 'ClientTeam';
    }

    // Admins read every submission's history at once for the Reports tab (a collection-group query).
    match /{path=**}/timeline/{entryId} {
      allow read: if isAdmin();
    }

    // ---------- reference data ----------
    // Team profiles (user type, contact details). Passwords are never stored here.
    // Only the Super Admin may create or change Admin / Super Admin accounts, or give someone those roles.
    match /users/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if isSuperAdmin() || (isAdmin() && !(request.resource.data.role in ['Admin', 'SuperAdmin']));
      allow update: if isSuperAdmin()
        || (isAdmin() && !(resource.data.role in ['Admin', 'SuperAdmin']) && !(request.resource.data.role in ['Admin', 'SuperAdmin']));
      allow delete: if isSuperAdmin();
    }
    // Clients: the admins see all; a Client Team member only the clients they look after.
    // PMs and PEs read none (their job openings carry the client's name).
    // (get also allows a missing id, so a new client's number can be checked for being free.)
    match /clients/{clientId} {
      allow get: if isAdmin() || (isClientTeamMember() && (resource == null || resource.data.assignedClientTeam == request.auth.uid));
      allow list: if isAdmin() || (isClientTeamMember() && resource.data.assignedClientTeam == request.auth.uid);
      allow create: if isAdmin() || isClientTeamMember();
      allow update, delete: if isAdmin() || (isClientTeamMember() && resource.data.assignedClientTeam == request.auth.uid);
    }

    // Job openings are handed down: the Client Team adds one, an Admin assigns it to a PM, and that PM
    // to a PE. Only the admins and the people on a job opening can read it.
    match /jobOpenings/{jobId} {
      function onJob(d) {
        return d.assignedClientTeam == request.auth.uid || d.assignedPM == request.auth.uid || d.assignedPE == request.auth.uid;
      }
      function clientTeamOfClient(clientId) {
        return get(/databases/$(database)/documents/clients/$(clientId)).data.assignedClientTeam;
      }
      function roleOf(uid) {
        return get(/databases/$(database)/documents/users/$(uid)).data.role;
      }
      function handDownKeys() {
        return ['assignedPM', 'pmAssignedAt', 'pmAssignedBy', 'pmAssignedByName',
                'assignedPE', 'peAssignedAt', 'peAssignedBy', 'peAssignedByName'];
      }
      function peKeys() {
        return ['assignedPE', 'peAssignedAt', 'peAssignedBy', 'peAssignedByName'];
      }
      // Notes are only ever added (one at a time, as yourself); earlier ones stay as they were.
      function notesAppendOnly() {
        let before = resource.data.get('notes', []);
        let after = request.resource.data.get('notes', []);
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['notes'])
          || (after.size() == before.size() + 1
              && after[0:before.size()] == before
              && after[before.size()].by == request.auth.uid);
      }

      allow get: if isAdmin() || (isMember() && (resource == null || onJob(resource.data)));
      allow list: if isAdmin() || (isMember() && onJob(resource.data));
      // A new job opening starts with the admins: no PM or PE yet.
      allow create: if isAdmin() || (isClientTeamMember()
        && request.resource.data.assignedClientTeam == clientTeamOfClient(request.resource.data.clientId)
        && request.resource.data.assignedPM == null
        && request.resource.data.assignedPE == null
        && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin()
        // The Client Team edits the title, details and status (and copies a client change), and adds notes; never the hand-down.
        || (isClientTeamMember() && resource.data.assignedClientTeam == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(handDownKeys())
            && request.resource.data.assignedClientTeam == clientTeamOfClient(request.resource.data.clientId)
            && notesAppendOnly())
        // The assigned PM chooses the PE (or none), and adds notes.
        || (isMember() && myRole() == 'PM' && resource.data.assignedPM == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(peKeys().concat(['notes']))
            && (request.resource.data.assignedPE == null || roleOf(request.resource.data.assignedPE) == 'PE')
            && notesAppendOnly())
        // The assigned PE adds notes.
        || (isMember() && myRole() == 'PE' && resource.data.assignedPE == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
            && notesAppendOnly());
      allow delete: if isAdmin() || (isClientTeamMember() && resource.data.assignedClientTeam == request.auth.uid);
    }

    // The candidate themself, apart from any client (see CandidateProfile in src/types).
    // people = the PE who added them and that PE's PM. Everyone who works on a candidate can delete them.
    match /candidates/{candidateId} {
      allow read: if isMember() && (isAdmin() || isClientTeamMember() || request.auth.uid in resource.data.people);
      // Written together with the PE's submission (a new candidate, or an existing one sent to another client).
      allow create: if isMember() && myRole() == 'PE'
        && request.resource.data.pe == request.auth.uid
        && request.auth.uid in request.resource.data.people
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember() && (isAdmin() || request.auth.uid in resource.data.people)
        && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['pe', 'createdAt', 'createdBy']);
      allow delete: if isMember() && (isAdmin() || isClientTeamMember() || request.auth.uid in resource.data.people);
    }

    // Which candidate each phone number belongs to (no two candidates share a number): phoneIndex/{digits
    // with country code, e.g. 919876543210} = { candidateId, pe, createdAt }. Anyone may look one number
    // up (it only names the candidate's ID), never list them. Written with the candidate's own record by
    // someone on that candidate; only the first claim counts.
    match /phoneIndex/{phone} {
      function candidatePath(id) {
        return /databases/$(database)/documents/candidates/$(id);
      }
      allow get: if isMember();
      allow list: if false;
      allow create: if isMember()
        && phone.matches('[0-9]{6,18}')
        && request.resource.data.keys().hasOnly(['candidateId', 'pe', 'createdAt'])
        && request.resource.data.candidateId is string
        && request.auth.uid in getAfter(candidatePath(request.resource.data.candidateId)).data.people;
      allow update: if isAdmin();
      // The candidate's number changed or they are deleted (an entry whose candidate is gone may be cleared by anyone).
      allow delete: if isAdmin() || isClientTeamMember()
        || !exists(candidatePath(resource.data.candidateId))
        || request.auth.uid in get(candidatePath(resource.data.candidateId)).data.people;
    }

    // Running ID series (candidates CN-0001…, clients CL-0001…, job openings JB-0001…): { last: n }.
    // Only ever counts up by one, in the same transaction that writes the new record.
    match /counters/{kind} {
      allow read: if isMember();
      allow create: if isMember() && kind in ['candidates', 'clients', 'jobs'] && request.resource.data.last == 1;
      allow update: if isMember() && request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }

    // Per-person app state (e.g. which new clients / job openings they've been alerted about). Own doc only.
    match /userState/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Conversations between a PE and one Admin / the Super Admin, or all admins ('admins').
    // pe = the PE the conversation belongs to; threadTo = who it is with; replyTo = its first message.
    // Only that PE and the admins it is with can read it; people can only mark messages read.
    match /messages/{messageId} {
      function msg(id) {
        return get(/databases/$(database)/documents/messages/$(id)).data;
      }
      function adminInThread(d) {
        return isAdmin() && d.threadTo in [request.auth.uid, 'admins'];
      }
      function validBody(d) {
        return d.body is string && d.body.size() > 0 && d.body.size() <= 2000
          && d.from == request.auth.uid && d.readBy.size() == 0;
      }
      // A reply must point at the first message of the same conversation.
      function inRootThread(d) {
        return d.replyTo is string && msg(d.replyTo).replyTo == null
          && msg(d.replyTo).pe == d.pe && msg(d.replyTo).threadTo == d.threadTo;
      }

      allow create: if isMember() && validBody(request.resource.data) && (
        // The PE starts a conversation, or answers in their own.
        (myRole() == 'PE'
          && request.resource.data.pe == request.auth.uid
          && request.resource.data.to == request.resource.data.threadTo
          && (request.resource.data.threadTo == 'admins'
              || get(/databases/$(database)/documents/users/$(request.resource.data.threadTo)).data.role in ['Admin', 'SuperAdmin'])
          && (request.resource.data.replyTo == null || inRootThread(request.resource.data)))
        // An admin the conversation is with replies to the PE.
        || (adminInThread(request.resource.data)
          && request.resource.data.to == request.resource.data.pe
          && inRootThread(request.resource.data))
      );
      allow read: if isMember() && (resource.data.pe == request.auth.uid || adminInThread(resource.data));
      allow update: if isMember() && (resource.data.pe == request.auth.uid || adminInThread(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.toSet() == resource.data.readBy.toSet().union([request.auth.uid].toSet());
      allow delete: if false;
    }

    // ---------- workflow helpers ----------

    // Both side statuses must be the fixed values that belong to the stage (no free-typed statuses).
    function statusesMatchStage(d) {
      return (d.stage == 'pe_submitted' && d.pmStatus == 'pending_pe_submission' && d.clientTeamStatus == 'not_sent_yet')
        || (d.stage == 'pe_query' && d.pmStatus == 'query_to_pe' && d.clientTeamStatus == 'not_sent_yet')
        || (d.stage == 'new_submission' && d.pmStatus == 'submitted_to_ct' && d.clientTeamStatus == 'pending_new_submission')
        || (d.stage == 'cv_with_client' && d.pmStatus == 'cv_with_client' && d.clientTeamStatus == 'pending_client_dates')
        || (d.stage == 'rescheduling'
            && ((d.pmStatus == 'pending_candidate_dates' && d.clientTeamStatus in ['pending_new_client_dates', 'client_dates_submitted'])
             || (d.pmStatus == 'candidate_dates_submitted' && d.clientTeamStatus == 'pending_schedule')))
        || (d.stage == 'interview_scheduled' && d.pmStatus == 'interview_scheduled' && d.clientTeamStatus == 'interview_scheduled')
        || (d.stage == 'debrief_pending' && d.clientTeamStatus == 'pending_client_debrief'
            && d.pmStatus in ['pending_candidate_debrief', 'candidate_debrief_received'])
        || (d.stage == 'closed_placed' && d.pmStatus == 'placed' && d.clientTeamStatus == 'placed')
        || (d.stage == 'closed_rejected' && d.pmStatus == 'rejected' && d.clientTeamStatus == 'rejected')
        || (d.stage == 'closed_backout' && d.pmStatus == 'backout' && d.clientTeamStatus == 'backout');
    }

    function isClosedStage(stage) {
      return stage in ['closed_placed', 'closed_rejected', 'closed_backout'];
    }

    // Stage moves only the Client Team may make (same stage = notes, date updates, mismatch loop).
    function clientTeamMoveAllowed(from, to) {
      return from == to
        || (from == 'new_submission' && to == 'cv_with_client')
        || (from == 'cv_with_client' && to in ['interview_scheduled', 'rescheduling', 'closed_rejected'])
        || (from == 'rescheduling' && to in ['interview_scheduled', 'closed_rejected'])
        || (from == 'interview_scheduled' && to in ['rescheduling', 'closed_placed', 'closed_rejected'])
        || (from == 'debrief_pending' && to in ['rescheduling', 'closed_placed', 'closed_rejected']);
    }

    match /applications/{appId} {
      function isPM(d) { return isMember() && d.assignedPM == request.auth.uid; }
      function isCT(d) { return isMember() && d.assignedClientTeam == request.auth.uid; }
      function isPE(d) { return isMember() && d.assignedPE == request.auth.uid; }

      function assignmentUnchanged() {
        return request.resource.data.diff(resource.data).unchangedKeys().hasAll([
          'assignedPM', 'assignedClientTeam', 'assignedPE', 'clientId', 'jobId', 'candidateId', 'createdAt', 'createdBy'
        ]);
      }

      // Opening a record: the only change is removing yourself from unreadFor.
      function isMarkRead() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadFor'])
          && request.resource.data.unreadFor.toSet() == resource.data.unreadFor.toSet().difference([request.auth.uid].toSet());
      }

      // Interview time (+5 min) passed → debrief pending. Either assigned user's dashboard may do it, only after the date.
      function isSystemMove() {
        return (isPM(resource.data) || isCT(resource.data))
          && resource.data.stage == 'interview_scheduled'
          && request.resource.data.stage == 'debrief_pending'
          && request.time.toMillis() > resource.data.interviewEndsAt
          && request.resource.data.lastUpdatedBy == 'system';
      }

      // PM: keeps the stage (new candidate dates, candidate debrief, notes), except on a PE's candidate:
      // ask the PE a question or reject it; and at any point, mark a candidate backout.
      function isPmChange() {
        return isPM(resource.data)
          && (request.resource.data.stage == resource.data.stage
              || (resource.data.stage == 'pe_submitted' && request.resource.data.stage in ['pe_query', 'closed_rejected'])
              || (!isClosedStage(resource.data.stage) && request.resource.data.stage == 'closed_backout'))
          && request.resource.data.lastUpdatedBy == request.auth.uid;
      }

      // PE: the candidate backed out (at any point before the record is closed).
      function isPeBackout() {
        return isPE(resource.data)
          && !isClosedStage(resource.data.stage)
          && request.resource.data.stage == 'closed_backout'
          && request.resource.data.lastUpdatedBy == request.auth.uid;
      }

      // PE: answers the PM's question; the candidate goes back to the PM.
      function isPeAnswer() {
        return isPE(resource.data)
          && resource.data.stage == 'pe_query'
          && request.resource.data.stage == 'pe_submitted'
          && request.resource.data.lastUpdatedBy == request.auth.uid;
      }

      function isClientTeamChange() {
        return isCT(resource.data)
          && clientTeamMoveAllowed(resource.data.stage, request.resource.data.stage)
          && request.resource.data.lastUpdatedBy == request.auth.uid;
      }

      function clientTeamOf(clientId) {
        return get(/databases/$(database)/documents/clients/$(clientId)).data.assignedClientTeam;
      }

      // PM sends a PE's candidate to the Client Team: the revised CV is added and the client / job
      // may be corrected, so the Client Team is (re)set from the client. The PE and PM stay the same.
      function isPmSendToClientTeam() {
        let d = request.resource.data;
        return isPM(resource.data)
          && resource.data.stage == 'pe_submitted'
          && d.stage == 'new_submission'
          && d.diff(resource.data).unchangedKeys().hasAll(['assignedPM', 'assignedPE', 'candidateId', 'createdAt', 'createdBy'])
          && d.assignedClientTeam == clientTeamOf(d.clientId)
          && d.revisedCvUrl is string && d.revisedCvUrl.size() > 0
          && d.lastUpdatedBy == request.auth.uid;
      }

      // The Client Team may also read other submissions: deleting a client (or a candidate) has to find
      // all of them, including ones not yet sent on. Their dashboard still only lists their own.
      allow read: if isAdmin() || isClientTeamMember() || isPM(resource.data) || isCT(resource.data) || isPE(resource.data);

      function jobOf(jobId) {
        return get(/databases/$(database)/documents/jobOpenings/$(jobId)).data;
      }

      // Candidates only enter through a PE, for a job opening assigned to them, and go to that job's PM
      // (PMs can't create them). The Client Team is not set (nor can see it) until the PM sends it on.
      allow create: if isPE(request.resource.data)
        && myRole() == 'PE'
        && request.resource.data.stage == 'pe_submitted'
        && statusesMatchStage(request.resource.data)
        && jobOf(request.resource.data.jobId).assignedPE == request.auth.uid
        && request.resource.data.assignedPM == jobOf(request.resource.data.jobId).assignedPM
        && request.resource.data.watchClientTeam == jobOf(request.resource.data.jobId).assignedClientTeam
        && request.resource.data.assignedClientTeam == ''
        && request.resource.data.candidateName is string && request.resource.data.candidateName.size() > 0
        && request.resource.data.candidateContactNumber is string && request.resource.data.candidateContactNumber.size() >= 10
        && request.resource.data.originalCvUrl is string && request.resource.data.originalCvUrl.size() > 0
        && request.resource.data.latestMessage is string && request.resource.data.latestMessage.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastUpdatedBy == request.auth.uid;

      allow update: if (statusesMatchStage(request.resource.data) && isPmSendToClientTeam())
        || (assignmentUnchanged() && (
          ((isPM(resource.data) || isCT(resource.data) || isPE(resource.data)) && isMarkRead())
          || (statusesMatchStage(request.resource.data) && (isSystemMove() || isPmChange() || isClientTeamChange() || isPeAnswer() || isPeBackout()))
        ));

      // Deleting a candidate or a client removes the submissions (children first; see deleteApplication).
      allow delete: if isAdmin() || isClientTeamMember() || isPM(resource.data) || isPE(resource.data);

      // ---------- subcollections ----------
      function parent() { return get(/databases/$(database)/documents/applications/$(appId)).data; }
      // getAfter: the parent may be created/updated in the same transaction.
      function parentAfter() { return getAfter(/databases/$(database)/documents/applications/$(appId)).data; }
      function canReadChildren() {
        let p = parent();
        return isAdmin() || isClientTeamMember() || isPM(p) || isCT(p) || isPE(p);
      }
      // Same people as for deleting the submission itself (the children go first, while it still exists).
      function canDeleteChildren() {
        let p = parent();
        return isAdmin() || isClientTeamMember() || isPM(p) || isPE(p);
      }
      // The PE writes the first history entries and dates only while creating the record.
      function canWriteChildren() {
        let p = parentAfter();
        return isPM(p) || isCT(p)
          || (isPE(p) && p.stage == 'pe_submitted' && !exists(/databases/$(database)/documents/applications/$(appId)));
      }

      // The PE's answer to the PM's question, or a backout the PE reports, adds one history entry.
      function peAnswering() {
        let p = parentAfter();
        return isPE(p)
          && exists(/databases/$(database)/documents/applications/$(appId))
          && ((p.stage == 'pe_submitted' && parent().stage == 'pe_query')
              || (p.stage == 'closed_backout' && parent().stage != 'closed_backout'));
      }

      // Append-only audit history.
      match /timeline/{entryId} {
        allow read: if canReadChildren();
        allow create: if (canWriteChildren() || peAnswering()) && request.resource.data.actor in [request.auth.uid, 'system'];
        allow update: if false;
        allow delete: if canDeleteChildren();
      }
      match /availabilityRounds/{roundId} {
        allow read: if canReadChildren();
        allow create, update: if canWriteChildren();
        allow delete: if canDeleteChildren();
      }
      match /interviews/{interviewId} {
        allow read: if canReadChildren();
        allow create, update: if canWriteChildren();
        allow delete: if canDeleteChildren();
      }
    }
  }
}
